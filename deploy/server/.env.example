# Copy to deploy/server/.env (never committed) and fill in.

# Your repository, e.g. https://github.com/my-account/dropzone
REPO_URL=https://github.com/OWNER/dropzone

# Settings > Actions > Runners > New self-hosted runner: the token shown in the
# "Configure" step (./config.sh --url ... --token XXXX). Valid for 1 hour.
RUNNER_TOKEN=

# Name shown in Settings > Actions > Runners
RUNNER_NAME=dropzone-server

# Port where the deployed application is published on this computer
APP_PORT=8080
